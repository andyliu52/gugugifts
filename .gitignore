# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# google business profile script
scripts/.google-business-credentials.json
scripts/.google-business-state.json

# square catalog script
scripts/.square-credentials.json
scripts/.square-state.json
scripts/.square-new-items.json
scripts/.square-new-items.md

# gohighlevel social planner
scripts/.ghl-credentials.json

# social pipeline artifacts — everything here regenerates from Square except
# posts.json (hand-authored marketing copy) and .ghl-posted.json, which is the
# only record of what has already been scheduled. GHL does not de-duplicate,
# so losing that file means re-posting everything on the next run.
social/*
!social/posts.json
!social/.ghl-posted.json

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# vercel
.vercel/
.vercel

# claude code local settings — but keep skills, which are shared project
# knowledge and should survive a fresh clone
.claude/*
!.claude/skills/
