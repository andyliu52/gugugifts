---
import { Image } from 'astro:assets';

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero/*.{jpg,jpeg}',
  { eager: true }
);
const photos = Object.entries(heroImages)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<section class="relative min-h-screen flex flex-col items-center justify-center px-6 overflow-hidden">
  <!-- Photo slideshow -->
  {photos.length > 0 && (
    <div class="hero-slideshow absolute inset-0">
      {photos.map((src, i) => (
        <div class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${i === 0 ? 'opacity-100' : 'opacity-0'}`}>
          <Image
            src={src}
            alt=""
            widths={[800, 1200, 1600, 2400]}
            sizes="100vw"
            formats={['avif', 'webp', 'jpeg']}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
  )}

  <!-- Cream wash so the wordmark stays legible over varied photos -->
  <div class="absolute inset-0 bg-gradient-to-b from-cream/85 via-cream/70 to-cream/90"></div>

  <!-- Background pattern -->
  <div class="absolute inset-0 pattern-botanical opacity-30"></div>

  <!-- Decorative top accent line -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-transparent to-gold/30"></div>

  <div class="relative text-center max-w-3xl mx-auto">
    <!-- Grand opening badge -->
    <div class="reveal inline-flex items-center gap-2 px-5 py-2.5 border border-gold/40 rounded-full text-xs uppercase tracking-[0.2em] text-gold mb-10 bg-cream/40 backdrop-blur-sm">
      <span class="w-1.5 h-1.5 bg-gold rounded-full animate-pulse"></span>
      Now Open
    </div>

    <!-- Wordmark -->
    <h1 class="reveal reveal-delay-1 text-6xl sm:text-7xl md:text-8xl lg:text-9xl tracking-wide mb-6">
      <span class="font-semibold">gugu</span><span class="font-light">gifts</span>
    </h1>

    <!-- Tagline -->
    <p class="reveal reveal-delay-2 font-playfair italic text-xl sm:text-2xl md:text-3xl text-bronze-light mb-8">
      Curated gifts for life's beautiful moments
    </p>

    <!-- Divider -->
    <div class="reveal reveal-delay-3 divider-gold mx-auto mb-8"></div>

    <!-- Address -->
    <p class="reveal reveal-delay-4 text-sm uppercase tracking-[0.15em] text-bronze font-medium">
      301 Tanger Dr, Suite 112 &bull; Terrell, TX 75160
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-warmgray">
    <span class="text-xs uppercase tracking-widest">Explore</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  if (slides.length > 1) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.replace('opacity-100', 'opacity-0');
      current = (current + 1) % slides.length;
      slides[current].classList.replace('opacity-0', 'opacity-100');
    }, 5000);
  }
</script>
