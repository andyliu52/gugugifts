---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { seoPages, getPage } from '../data/seoLandingPages';

export function getStaticPaths() {
  return seoPages.map((page) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
const page = getPage(slug!)!;

const site = Astro.site ?? new URL('https://www.gugugifts.com');
const pageURL = new URL(`/${page.slug}`, site).toString();

const related = page.related
  .map((s) => getPage(s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Per-page structured data: breadcrumb trail + FAQ rich results.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
    { '@type': 'ListItem', position: 2, name: page.h1, item: pageURL },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const directionsURL =
  'https://maps.google.com/?q=301+Tanger+Dr+Suite+112+Terrell+TX+75160';
---

<Layout title={`${page.title} | Gugu Gifts`} description={page.description} localized={false} ogImage={`/og/${page.slug}.jpg`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Navbar />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative pt-36 pb-16 md:pt-44 md:pb-20 px-6 overflow-hidden">
      <div class="absolute inset-0 pattern-botanical opacity-20"></div>
      <div class="relative max-w-3xl mx-auto text-center">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex items-center justify-center gap-2 text-xs uppercase tracking-[0.15em] text-warmgray">
            <li><a href="/" class="hover:text-gold transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-gold">{page.eyebrow}</li>
          </ol>
        </nav>
        <h1 class="font-playfair text-4xl md:text-5xl lg:text-6xl leading-tight mb-6">{page.h1}</h1>
        <div class="divider-gold mx-auto mb-8"></div>
        <div class="space-y-5 text-bronze-light leading-relaxed text-left sm:text-center">
          {page.intro.map((p) => <p set:html={p} />)}
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href={directionsURL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-gold text-white text-sm uppercase tracking-widest font-medium hover:bg-gold/90 transition-colors"
          >
            Get Directions
          </a>
          <a
            href="/#shop"
            class="inline-flex items-center gap-2 px-7 py-3 rounded-full border border-gold/40 text-sm uppercase tracking-widest font-medium hover:border-gold hover:text-gold transition-colors"
          >
            Browse the Shop
          </a>
        </div>
      </div>
    </section>

    <!-- Highlights -->
    <section class="py-16 md:py-20 px-6 bg-cream-dark/50">
      <div class="max-w-6xl mx-auto">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.highlights.map((h) => (
            <div class="reveal bg-cream border border-gold/15 rounded-2xl p-8 h-full">
              <h2 class="font-playfair text-xl md:text-2xl mb-3">{h.title}</h2>
              <p class="text-bronze-light leading-relaxed">{h.body}</p>
            </div>
          ))}
        </div>

        {page.brands && page.brands.length > 0 && (
          <div class="mt-12 text-center">
            <p class="text-xs uppercase tracking-[0.2em] text-gold mb-5 font-medium">Brands you'll find here</p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              {page.brands.map((b) => (
                <span class="px-5 py-2 rounded-full bg-cream border border-gold/20 text-sm tracking-wide">{b}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Visit us (self-contained NAP + hours) -->
    <section class="py-16 md:py-24 px-6">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="reveal text-xs uppercase tracking-[0.2em] text-gold mb-4 font-medium">Visit Gugu Gifts</p>
          <h2 class="reveal reveal-delay-1 font-playfair text-3xl md:text-4xl mb-6">Find us at Tanger Outlets</h2>
          <div class="reveal reveal-delay-2 space-y-5 text-bronze-light">
            <div>
              <h3 class="font-medium text-bronze mb-1">Address</h3>
              <p class="leading-relaxed">
                301 Tanger Dr, Suite 112<br />
                Terrell, TX 75160<br />
                <span class="text-warmgray text-sm">(former Claire's location)</span>
              </p>
              <a href={directionsURL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-2 text-sm text-gold hover:text-gold/80 transition-colors">
                Get Directions →
              </a>
            </div>
            <div>
              <h3 class="font-medium text-bronze mb-1">Hours</h3>
              <dl class="text-sm leading-relaxed space-y-0.5">
                <div class="flex justify-between gap-6 max-w-xs"><dt>Tuesday – Saturday</dt><dd>10 AM – 7 PM</dd></div>
                <div class="flex justify-between gap-6 max-w-xs"><dt>Sunday</dt><dd>11 AM – 6 PM</dd></div>
                <div class="flex justify-between gap-6 max-w-xs"><dt>Monday</dt><dd class="text-warmgray">Closed</dd></div>
              </dl>
            </div>
            <div>
              <h3 class="font-medium text-bronze mb-1">Email</h3>
              <a href="mailto:gugu@gugugifts.com" class="text-bronze-light hover:text-gold transition-colors">gugu@gugugifts.com</a>
            </div>
          </div>
        </div>
        <div class="reveal reveal-delay-3">
          <div class="rounded-2xl overflow-hidden border border-gold/20 shadow-lg">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3361.0!2d-96.2753!3d32.7191!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x864ea5c0000000%3A0x0!2s301+Tanger+Dr+Terrell+TX+75160!5e0!3m2!1sen!2sus!4v1"
              width="100%"
              height="340"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Gugu Gifts location on Google Maps"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 md:py-20 px-6 bg-cream-dark/50">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <p class="text-xs uppercase tracking-[0.2em] text-gold mb-4 font-medium">Good to know</p>
          <h2 class="font-playfair text-3xl md:text-4xl">Frequently asked questions</h2>
        </div>
        <div class="space-y-4">
          {page.faq.map((f) => (
            <div class="bg-cream border border-gold/15 rounded-2xl p-6 md:p-8">
              <h3 class="font-medium text-lg mb-2">{f.q}</h3>
              <p class="text-bronze-light leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related pages -->
    {related.length > 0 && (
      <section class="py-16 md:py-20 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-[0.2em] text-gold mb-4 font-medium">Keep exploring</p>
            <h2 class="font-playfair text-3xl md:text-4xl">You might also like</h2>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {related.map((r) => (
              <a href={`/${r.slug}`} class="group block bg-cream border border-gold/15 rounded-2xl p-6 transition-all duration-300 hover:border-gold/40 hover:shadow-lg hover:shadow-gold/5 hover:-translate-y-1">
                <p class="text-xs uppercase tracking-widest text-gold/70 mb-2">{r.eyebrow}</p>
                <h3 class="font-playfair text-lg group-hover:text-gold transition-colors">{r.h1}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
  <CookieConsent />
</Layout>
